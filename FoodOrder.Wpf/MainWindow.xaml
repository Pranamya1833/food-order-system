<Window x:Class="FoodOrder.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Food Order System" Height="760" Width="1180" MinWidth="980" MinHeight="640"
        Background="#F5F3F0" FontFamily="Segoe UI Variable Display, Segoe UI">

    <Window.Resources>

        <!-- Primary button -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#EF4F2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outline button for the header -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="#99FFFFFF" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Add button on dish cards -->
        <Style x:Key="AddButton" TargetType="Button">
            <Setter Property="Foreground" Value="#1E8E5A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" BorderBrush="#CFE6D9" BorderThickness="1.5"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8F6EE"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1E8E5A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Plus and minus buttons in the cart -->
        <Style x:Key="StepButton" TargetType="Button">
            <Setter Property="Foreground" Value="#1E8E5A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text-style link button -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="#EF4F2D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header tabs -->
        <Style x:Key="NavRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="12" Padding="18,8">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter chips -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#3A3540"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="White" BorderBrush="#E4DFD9" BorderThickness="1"
                                CornerRadius="18" Padding="16,8">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E1A24"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1E1A24"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded text boxes -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="#F3F0EC" BorderBrush="Transparent" BorderThickness="1.5"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#EF4F2D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputPass" TargetType="PasswordBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" Background="#F3F0EC" BorderBrush="Transparent" BorderThickness="1.5"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#EF4F2D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1E1A24"/>
        </Style>

        <!-- Dish card -->
        <DataTemplate x:Key="MenuCardTemplate">
            <Border Width="214" Margin="8" Opacity="0">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.35"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Border x:Name="CardBorder" Background="White" CornerRadius="20" Padding="14"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.10" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Background="#FFF0E4" CornerRadius="16" Height="120">
                            <Grid>
                                <TextBlock x:Name="EmojiText" Text="{Binding Emoji}" FontSize="56"
                                           FontFamily="Segoe UI Emoji" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <Border CornerRadius="16">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Photo}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="2,12,0,0">
                            <Border Width="14" Height="14" CornerRadius="3" BorderThickness="1.5"
                                    BorderBrush="{Binding DotColor}" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{Binding DotColor}"/>
                            </Border>
                            <TextBlock Text="{Binding Kind}" Margin="8,0,0,0" FontSize="12" Foreground="#7A7581"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Margin="2,4,0,2"
                                   TextWrapping="Wrap" Foreground="#1E1A24"/>
                        <TextBlock Text="{Binding Price}" FontSize="15" Margin="2,0,0,0" Foreground="#3A3540"/>
                        <Button Content="Add" Tag="{Binding Id}" Click="Plus_Click"
                                Style="{StaticResource AddButton}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="CardBorder" Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="CardBorder"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.04" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="CardBorder"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.04" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="EmojiText"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 To="12" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="CardBorder"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="CardBorder"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="EmojiText"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 To="0" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Cart row -->
        <DataTemplate x:Key="CartRowTemplate">
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="76"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Emoji}" FontSize="24" FontFamily="Segoe UI Emoji"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                           TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#1E1A24"/>
                <Border Grid.Column="2" BorderBrush="#CFE6D9" BorderThickness="1.5" CornerRadius="8" Margin="8,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="-" Tag="{Binding Id}" Click="Minus_Click"
                                Style="{StaticResource StepButton}"/>
                        <TextBlock Text="{Binding Qty}" VerticalAlignment="Center" FontWeight="Bold"
                                   Foreground="#1E8E5A" MinWidth="16" TextAlignment="Center"/>
                        <Button Content="+" Tag="{Binding Id}" Click="Plus_Click"
                                Style="{StaticResource StepButton}"/>
                    </StackPanel>
                </Border>
                <TextBlock Grid.Column="3" Text="{Binding LineTotal}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#1E1A24"/>
            </Grid>
        </DataTemplate>

        <!-- Order card -->
        <DataTemplate x:Key="OrderTemplate">
            <Border Background="White" CornerRadius="16" Padding="18" Margin="0,0,0,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.08" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Emojis}" FontSize="26" FontFamily="Segoe UI Emoji"
                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" Foreground="#1E1A24"/>
                        <TextBlock Text="{Binding Items}" Foreground="#7A7581" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Total}" FontWeight="Bold" FontSize="17"
                                   HorizontalAlignment="Right" Foreground="#1E1A24"/>
                        <Border Background="#FFEFE8" CornerRadius="10" Padding="10,3" Margin="0,6,0,0"
                                HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Status}" Foreground="#EF4F2D" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Report row with a bar -->
        <DataTemplate x:Key="ReportRowTemplate">
            <Grid Margin="0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" FontSize="15" VerticalAlignment="Center" Foreground="#1E1A24"/>
                <Border Grid.Column="1" Height="10" CornerRadius="5" Background="#F1EDE8" Margin="8,0">
                    <Border Height="10" CornerRadius="5" Background="#EF4F2D" HorizontalAlignment="Left"
                            Width="{Binding Bar}"/>
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding Value}" FontWeight="SemiBold" FontSize="15"
                           VerticalAlignment="Center" MinWidth="90" TextAlignment="Right" Foreground="#1E1A24"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>

        <!-- ============ Main app ============ -->
        <Grid x:Name="AppRoot" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="24,12">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#EF4F2D" Offset="0"/>
                        <GradientStop Color="#F6A61C" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#x1F374;" FontSize="26" FontFamily="Segoe UI Emoji" Margin="0,0,10,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Food Order System" Foreground="White" FontSize="22" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <RadioButton x:Name="NavMenu" Content="Menu" Tag="Menu" GroupName="Nav" IsChecked="True"
                                     Checked="Nav_Checked" Style="{StaticResource NavRadio}"/>
                        <RadioButton x:Name="NavOrders" Content="Orders" Tag="Orders" GroupName="Nav"
                                     Checked="Nav_Checked" Style="{StaticResource NavRadio}"/>
                        <RadioButton x:Name="NavReports" Content="Reports" Tag="Reports" GroupName="Nav"
                                     Checked="Nav_Checked" Style="{StaticResource NavRadio}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#33FFFFFF" CornerRadius="16" Padding="12,6" Margin="0,0,14,0"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="BadgeScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F6D2;" FontSize="16" FontFamily="Segoe UI Emoji"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="CartCountText" Text="0" Foreground="White" FontWeight="Bold"
                                           FontSize="15" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="GreetingText" Foreground="White" FontWeight="SemiBold" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="Log out" Click="Logout_Click" Style="{StaticResource GhostButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20">

                <!-- Menu tab -->
                <Grid x:Name="MenuPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <Grid Margin="0,0,14,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" CornerRadius="20" Padding="24,18" Margin="0,0,0,14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1E1A24" Offset="0"/>
                                    <GradientStop Color="#3B2740" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="What are you craving today?" Foreground="White" FontSize="24"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="Pick a dish, add it to your cart and place the order."
                                               Foreground="#CFC8D6" FontSize="14" Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock Text="&#x1F35C; &#x1F355; &#x1F370;" FontSize="38"
                                           FontFamily="Segoe UI Emoji" HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="White" CornerRadius="14" Padding="14,4" BorderBrush="#E4DFD9"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#x1F50D;" FontFamily="Segoe UI Emoji" FontSize="15"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" FontSize="15"
                                             Background="Transparent" Padding="0,8"
                                             VerticalContentAlignment="Center" TextChanged="Filter_Changed"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <RadioButton x:Name="ChipAll" Content="All" GroupName="Cat" IsChecked="True"
                                             Checked="Filter_Changed" Style="{StaticResource Chip}"/>
                                <RadioButton x:Name="ChipVeg" Content="Veg" GroupName="Cat"
                                             Checked="Filter_Changed" Style="{StaticResource Chip}"/>
                                <RadioButton x:Name="ChipNonVeg" Content="Non-veg" GroupName="Cat"
                                             Checked="Filter_Changed" Style="{StaticResource Chip}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="MenuItemsView" ItemTemplate="{StaticResource MenuCardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock x:Name="NoResultsText" Text="No dishes match your search. Try another name."
                                       Foreground="#7A7581" FontSize="15" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>

                    <!-- Cart -->
                    <Border Grid.Column="1" Background="White" CornerRadius="20" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.10" Color="#000000"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="CartTitle" Text="Your cart" Style="{StaticResource Header}"/>
                            <Grid Grid.Row="1" Margin="0,10">
                                <ListBox x:Name="CartList" ItemTemplate="{StaticResource CartRowTemplate}"
                                         HorizontalContentAlignment="Stretch"/>
                                <StackPanel x:Name="EmptyCartPanel" HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="&#x1F961;" FontSize="48" FontFamily="Segoe UI Emoji"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Your cart is empty" FontWeight="SemiBold" FontSize="15"
                                               HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="#1E1A24"/>
                                    <TextBlock Text="Add a dish from the menu to get started." Foreground="#7A7581"
                                               FontSize="13" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CouponBox" Style="{StaticResource InputBox}"/>
                                <Button Grid.Column="1" Content="Apply" Click="ApplyCoupon_Click" Margin="8,0,0,0"
                                        Background="#1E1A24"/>
                            </Grid>
                            <TextBlock x:Name="CouponMessage" Grid.Row="3" Foreground="#1E8E5A" FontSize="12"
                                       Margin="2,6,0,10" Text="Try SAVE10, FLAT50 or BIG100"/>
                            <Grid Grid.Row="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Item total" Foreground="#7A7581"/>
                                <TextBlock x:Name="ItemTotalText" Grid.Column="1" Text="Rs. 0"/>
                                <TextBlock Grid.Row="1" Text="Discount" Foreground="#7A7581" Margin="0,4,0,0"/>
                                <TextBlock x:Name="DiscountText" Grid.Row="1" Grid.Column="1" Text="- Rs. 0"
                                           Foreground="#1E8E5A" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="2" Text="To pay" FontWeight="Bold" FontSize="18" Margin="0,10,0,0"/>
                                <TextBlock x:Name="ToPayText" Grid.Row="2" Grid.Column="1" Text="Rs. 0"
                                           FontWeight="Bold" FontSize="18" Margin="0,10,0,0"/>
                            </Grid>
                            <Button x:Name="PlaceOrderButton" Grid.Row="5" Content="Place order" Margin="0,16,0,0"
                                    Click="PlaceOrder_Click" Background="#1E8E5A" FontSize="15"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Orders tab -->
                <Grid x:Name="OrdersPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Your orders" Style="{StaticResource Header}" Margin="0,0,0,12"/>
                    <Grid Grid.Row="1">
                        <ListBox x:Name="OrdersList" ItemTemplate="{StaticResource OrderTemplate}"
                                 HorizontalContentAlignment="Stretch"/>
                        <TextBlock x:Name="NoOrdersText" Text="No orders yet. Place one from the Menu tab."
                                   Foreground="#7A7581" FontSize="15" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Grid>

                <!-- Reports tab -->
                <ScrollViewer x:Name="ReportsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#1E1A24" CornerRadius="20" Padding="22" Margin="0,0,7,0">
                                <StackPanel>
                                    <TextBlock Text="Total revenue" Foreground="#CFC8D6"/>
                                    <TextBlock x:Name="RevenueText" Text="Rs. 0" FontSize="38" FontWeight="Bold"
                                               Foreground="White" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="White" CornerRadius="20" Padding="22" Margin="7,0">
                                <StackPanel>
                                    <TextBlock Text="Orders" Foreground="#7A7581"/>
                                    <TextBlock x:Name="OrderCountText" Text="0" FontSize="32" FontWeight="Bold"
                                               Foreground="#1E1A24" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="White" CornerRadius="20" Padding="22" Margin="7,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Average order" Foreground="#7A7581"/>
                                    <TextBlock x:Name="AverageText" Text="Rs. 0" FontSize="32" FontWeight="Bold"
                                               Foreground="#1E1A24" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Background="White" CornerRadius="20" Padding="22" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Best sellers" Style="{StaticResource Header}"/>
                                <ItemsControl x:Name="TopItemsList" ItemTemplate="{StaticResource ReportRowTemplate}"
                                              Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="20" Padding="22">
                            <StackPanel>
                                <TextBlock Text="Revenue by day" Style="{StaticResource Header}"/>
                                <ItemsControl x:Name="DailyList" ItemTemplate="{StaticResource ReportRowTemplate}"
                                              Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ============ Login and sign up ============ -->
        <Grid x:Name="LoginRoot">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1E1A24" Offset="0"/>
                    <GradientStop Color="#3B2740" Offset="0.6"/>
                    <GradientStop Color="#5A2A3A" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <Canvas x:Name="RainCanvas" IsHitTestVisible="False" ClipToBounds="True"/>

            <Border Width="400" Background="White" CornerRadius="26" Padding="34,30"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.35" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="&#x1F354;" FontSize="56" FontFamily="Segoe UI Emoji"
                               HorizontalAlignment="Center">
                        <TextBlock.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         From="0" To="-12" Duration="0:0:0.7">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                    <TextBlock Text="Food Order System" FontSize="26" FontWeight="Bold" Foreground="#1E1A24"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    <TextBlock x:Name="AuthTitle" Text="Log in to start ordering" FontSize="14"
                               Foreground="#7A7581" HorizontalAlignment="Center" Margin="0,4,0,18"/>

                    <TextBlock Text="Username" FontSize="13" FontWeight="SemiBold" Foreground="#3A3540"
                               Margin="2,0,0,4"/>
                    <TextBox x:Name="UserBox" Style="{StaticResource InputBox}"/>
                    <TextBlock Text="Password" FontSize="13" FontWeight="SemiBold" Foreground="#3A3540"
                               Margin="2,12,0,4"/>
                    <PasswordBox x:Name="PassBox" Style="{StaticResource InputPass}"/>

                    <TextBlock x:Name="AuthMessage" Foreground="#C0392B" FontSize="13" TextWrapping="Wrap"
                               Margin="2,10,0,0" MinHeight="18"/>
                    <Button x:Name="AuthSubmit" Content="Log in" Click="AuthSubmit_Click" Margin="0,8,0,0"
                            FontSize="15"/>
                    <Button x:Name="ToggleModeButton" Content="New here? Create an account"
                            Click="ToggleMode_Click" Style="{StaticResource LinkButton}" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ Toast ============ -->
        <Border x:Name="Toast" Visibility="Collapsed" Background="#1E1A24" CornerRadius="14" Padding="20,12"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastShift" Y="0"/>
            </Border.RenderTransform>
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
        </Border>

        <!-- ============ Order placed ============ -->
        <Grid x:Name="SuccessOverlay" Background="#B31E1A24" Visibility="Collapsed"
              MouseDown="Overlay_Click">
            <Canvas x:Name="ConfettiCanvas" IsHitTestVisible="False" ClipToBounds="True"/>
            <Border x:Name="SuccessCard" Width="360" Background="White" CornerRadius="26" Padding="30"
                    HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="SuccessScale" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <StackPanel>
                    <TextBlock Text="&#x1F389;" FontSize="64" FontFamily="Segoe UI Emoji"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="SuccessTitle" Text="Order placed" FontSize="24" FontWeight="Bold"
                               Foreground="#1E1A24" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock x:Name="SuccessSub" Text="" FontSize="15" Foreground="#7A7581"
                               HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Click anywhere to continue" FontSize="12" Foreground="#A8A2AF"
                               HorizontalAlignment="Center" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
